# Model backend.
#
# Option A: Gemini via Google's OpenAI-compatible endpoint.
# GEMINI_API_KEY=your_gemini_api_key_here
# OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# MODEL_NAME=gemini-2.5-flash

# Option B: Azure/OpenAI-compatible endpoint.
# OPENAI_API_KEY=your_openai_or_azure_key_here
# OPENAI_BASE_URL=https://your-endpoint/openai/v1/
# MODEL_NAME=gpt-4.1

# LangSmith (optional - for tracing and monitoring)
# LANGCHAIN_TRACING_V2=true
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com
# LANGCHAIN_API_KEY=your_langsmith_api_key_here
# LANGCHAIN_PROJECT=text2sql-deepagent

# Tavily API (optional - for web search capabilities)
# TAVILY_API_KEY=your_tavily_api_key_here

# Optional evolver paths.
TEXT2SQL_DB=chinook.db
TEXT2SQL_DATASET=data/chinook_eval.jsonl
TEXT2SQL_REPORTS=reports
