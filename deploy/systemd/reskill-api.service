[Unit]
Description=ReskillSQL authenticated query API
After=network-online.target
Wants=network-online.target

[Service]
User=reskill
Group=reskill
WorkingDirectory=/opt/reskill
EnvironmentFile=/etc/reskill/runtime.env
ExecStart=/opt/reskill/.venv/bin/text2sql-runtime --root /var/lib/reskill serve
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/reskill
MemoryMax=512M
TasksMax=128

[Install]
WantedBy=multi-user.target
